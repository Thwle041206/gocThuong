{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control for authentication",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Collection of trusted admin credentials",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Post": {
      "title": "Post",
      "description": "Article or blog post entity for the CMS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title_en": { "type": "string" },
        "title_vi": { "type": "string" },
        "excerpt_en": { "type": "string" },
        "excerpt_vi": { "type": "string" },
        "content_en": { "type": "string" },
        "content_vi": { "type": "string" },
        "category": { "type": "string" },
        "tag": { "type": "string" },
        "image": { "type": "string" },
        "readTime": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "authorName": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title_vi", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "Showcase portfolio project entity for the CMS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "title_en": { "type": "string" },
        "title_vi": { "type": "string" },
        "category_en": { "type": "string" },
        "category_vi": { "type": "string" },
        "categoryBadge": { "type": "string" },
        "filterTag": { "type": "string" },
        "year": { "type": "string" },
        "description_en": { "type": "string" },
        "description_vi": { "type": "string" },
        "image": { "type": "string" },
        "deliverables": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Article category entity with create, edit, delete capabilities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "label_vi": { "type": "string" },
        "label_en": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "EditorialTag": {
      "title": "EditorialTag",
      "description": "Editorial badge and tag entity with create, edit, delete capabilities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "label_vi": { "type": "string" },
        "label_en": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "SiteSection": {
      "title": "SiteSection",
      "description": "Customizable content for site headers and sections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile with role definition (user or admin)"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Trusted admin documents"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Collection of editorial blog articles managed via CMS"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Collection of portfolio projects managed via CMS"
    },
    "/categories/{catId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Collection of dynamic blog categories"
    },
    "/editorial_tags/{tagId}": {
      "schema": { "$ref": "#/entities/EditorialTag" },
      "description": "Collection of dynamic editorial tags"
    },
    "/site_sections/{sectionId}": {
      "schema": { "$ref": "#/entities/SiteSection" },
      "description": "Configurable header and page content for Trang chu, Du an, Dich vu, Bai viet, Ket noi"
    }
  }
}
